---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Análisis técnicos, guías y comparativas de compra honestas y directas.' } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-emerald-50/60 text-emerald-950 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="sEIh7kn3CEZraiOWujmvt8YT0IOEQykGasfi4-RXgiY" />
    
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TNB5S87DZC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-TNB5S87DZC');
    </script>

    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-emerald-600 selection:text-white bg-emerald-50/60 text-emerald-950 font-sans">
    <!-- Encabezado / Navegación Sticky con efecto Glassmorphism -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 border-b border-emerald-100 shadow-xs transition-all duration-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-xl font-black tracking-tight text-emerald-950 hover:text-emerald-700 transition-colors group">
          <span class="w-9 h-9 bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-xl flex items-center justify-center text-sm font-black shadow-md shadow-emerald-700/20 group-hover:scale-105 transition-transform">
            CM
          </span>
          <div class="flex flex-col">
            <span class="leading-none text-lg text-emerald-950 font-black">CompraMaestra</span>
            <span class="text-[10px] uppercase font-bold tracking-widest text-emerald-700/70">Guías & Comparativas</span>
          </div>
        </a>
        <nav class="flex items-center gap-4 text-sm font-medium text-emerald-800">
          <a href="/" class="hover:text-emerald-600 transition-colors font-semibold hidden sm:inline-block">Inicio</a>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
            Análisis 100% Verificados
          </span>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Pie de página con aviso legal de afiliación -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-20 text-xs sm:text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8 text-center sm:text-left">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-slate-800/80">
          <div class="space-y-3">
            <div class="flex items-center justify-center sm:justify-start gap-2">
              <span class="w-7 h-7 bg-emerald-600 text-white rounded-lg flex items-center justify-center text-xs font-bold">CM</span>
              <span class="text-white font-bold text-base">CompraMaestra</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed max-w-sm mx-auto sm:mx-0">
              Laboratorio editorial independiente dedicado a evaluar productos con rigor técnico, pruebas objetivas y datos reales para el consumidor inteligente.
            </p>
          </div>
          <div class="md:col-span-2">
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-800/60 border border-slate-700/60 text-slate-300">
              <p class="font-semibold text-slate-200 mb-1.5 flex items-center justify-center sm:justify-start gap-2">
                <span>🛡️</span> Transparencia y Aviso Legal de Afiliación
              </p>
              <p class="text-xs text-slate-400 leading-relaxed">
                En calidad de Afiliado de Amazon, CompraMaestra obtiene ingresos por las compras adscritas que cumplen los requisitos aplicables. Los enlaces a Amazon disponibles en nuestros análisis incorporan etiquetas de seguimiento que no repercuten ningún coste adicional sobre el precio del producto para el comprador. Nuestras evaluaciones son 100% editoriales y libres de acuerdos con fabricantes.
              </p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} CompraMaestra. Todos los derechos reservados.</p>
          <p class="flex items-center gap-2">
            <span>Astro</span> · <span>Tailwind CSS</span> · <span>Cloudflare Pages</span>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
