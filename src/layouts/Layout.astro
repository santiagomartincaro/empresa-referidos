---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Análisis técnicos, guías y comparativas de compra honestas y directas.' } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-slate-50 text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Encabezado / Navegación -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-xl font-black tracking-tight text-slate-900 hover:text-amber-600 transition-colors">
          <span class="p-1.5 bg-amber-500 text-white rounded-lg text-sm leading-none font-bold">TOP</span>
          <span>Guías & Referidos</span>
        </a>
        <nav class="flex items-center gap-4 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-amber-600 transition-colors">Inicio</a>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
            Análisis 100% Reales
          </span>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Pie de página con aviso legal de afiliación -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-16 text-xs sm:text-sm">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-6 text-center sm:text-left">
        <div class="p-4 rounded-xl bg-slate-800/80 border border-slate-700/60 text-slate-300">
          <p class="font-medium text-slate-200 mb-1">Aviso legal sobre el programa de afiliados</p>
          <p class="text-xs text-slate-400 leading-relaxed">
            En calidad de Afiliado de Amazon, este sitio web obtiene ingresos por las compras adscritas que cumplen los requisitos aplicables. Los enlaces a Amazon disponibles en nuestros análisis incorporan etiquetas de seguimiento que no repercuten ningún coste adicional sobre el precio del producto para el comprador.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-slate-800/80 pt-6 text-xs">
          <p>© {new Date().getFullYear()} Guías & Referidos. Todos los derechos reservados.</p>
          <p class="text-slate-500">Desplegado en Cloudflare Pages · Maquetado con Astro & Tailwind CSS</p>
        </div>
      </div>
    </footer>
  </body>
</html>
