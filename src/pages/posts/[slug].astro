---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const rawPosts = import.meta.glob('../../../content/posts/*.md', { eager: true });
  return Object.values(rawPosts).map((post: any) => {
    const slug = post.frontmatter?.slug || post.file?.split('/')?.pop()?.replace('.md', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
---

<Layout title={`${frontmatter.title} | CompraMaestra`} description={frontmatter.description}>
  <!-- Migas de pan / Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 mb-6 overflow-x-auto whitespace-nowrap pb-2">
    <a href="/" class="hover:text-amber-600 transition-colors">Inicio</a>
    <span>/</span>
    <span class="text-slate-700 font-medium">{frontmatter.category || 'Comparativa'}</span>
    <span>/</span>
    <span class="text-slate-400 truncate max-w-[200px] sm:max-w-none">{frontmatter.title}</span>
  </nav>

  <!-- Encabezado del Artículo -->
  <header class="mb-8 border-b border-slate-200 pb-8">
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="px-3 py-1 text-xs font-bold rounded-lg bg-amber-100 text-amber-900 uppercase tracking-wider">
        {frontmatter.category}
      </span>
      {frontmatter.pubDate && (
        <span class="text-xs text-slate-500">
          Actualizado: {new Date(frontmatter.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
      )}
      <span class="text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full font-medium">
        ✓ Datos técnicos verificados
      </span>
    </div>

    <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight mb-4">
      {frontmatter.title}
    </h1>

    {frontmatter.description && (
      <p class="text-base sm:text-xl text-slate-600 leading-relaxed font-normal">
        {frontmatter.description}
      </p>
    )}
  </header>

  <!-- Cuerpo del Artículo Renderizado con Tailwind Typography -->
  <article class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 prose-h2:text-2xl prose-h2:border-b prose-h2:border-slate-200 prose-h2:pb-2.5 prose-h2:mt-10 prose-h3:text-xl prose-h3:text-slate-800 prose-p:leading-relaxed prose-li:leading-relaxed prose-strong:text-slate-900">
    <Content />
  </article>

  <!-- Caja de Cierre / Transparencia de Afiliación -->
  <aside class="mt-12 p-6 rounded-2xl bg-amber-50/70 border border-amber-200/80">
    <h3 class="text-sm font-bold text-amber-950 uppercase tracking-wider mb-2 flex items-center gap-2">
      <span>🛡️</span> Criterio de Selección Independiente
    </h3>
    <p class="text-xs sm:text-sm text-amber-900/80 leading-relaxed">
      Nuestras recomendaciones se basan en especificaciones técnicas de laboratorio, pruebas empíricas y opiniones de usuarios contrastadas. Al comprar mediante los botones de Amazon de este artículo recibimos una pequeña comisión que nos permite mantener este proyecto sin patrocinios sesgados.
    </p>
  </aside>

  <!-- Botón Volver -->
  <div class="mt-10 pt-6 border-t border-slate-200 flex justify-center sm:justify-start">
    <a 
      href="/" 
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition-colors"
    >
      ← Volver a todas las comparativas
    </a>
  </div>
</Layout>
