---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contacto y Atención al Lector | CompraMaestra" 
  description="Contacta con el equipo editorial de CompraMaestra. Envía dudas técnicas, sugerencias de nuevos productos o solicitudes de corrección de datos."
>
  <div class="space-y-10 sm:space-y-12 max-w-4xl mx-auto">
    <!-- Encabezado -->
    <header class="text-center space-y-3 pt-4 sm:pt-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-100/80 text-emerald-900 border border-emerald-200">
        <span>✉️</span>
        Canal Directo de Comunicación
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-emerald-950">
        Ponte en Contacto
      </h1>
      <p class="text-sm sm:text-base text-emerald-800/80 max-w-xl mx-auto">
        ¿Tienes dudas sobre una comparativa, has detectado un error técnico en alguna ficha o quieres sugerir un nuevo producto para análisis? Te escuchamos.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      <!-- Tarjeta informativa lateral -->
      <div class="lg:col-span-1 space-y-6">
        <div class="bg-white p-6 rounded-3xl border border-emerald-100 shadow-sm space-y-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-600/10 text-emerald-700 flex items-center justify-center font-bold text-xl">
            📬
          </div>
          <h2 class="text-lg font-bold text-emerald-950">Atención Editorial</h2>
          <p class="text-xs sm:text-sm text-emerald-900/75 leading-relaxed">
            Revisamos manualmente cada mensaje recibido para mejorar la calidad y precisión de nuestras guías de compra.
          </p>
          <div class="pt-2 border-t border-emerald-50 space-y-2 text-xs text-emerald-900/80">
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">⏱️ Plazo de respuesta:</span>
              <span>24 a 48 horas laborables</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">📍 Idioma:</span>
              <span>Español / English</span>
            </div>
          </div>
        </div>

        <div class="bg-emerald-950 text-emerald-100 p-6 rounded-3xl shadow-md space-y-3">
          <div class="flex items-center gap-2 text-white font-bold text-sm">
            <span>🛡️</span>
            <span>Aviso sobre Marcas y Patrocinios</span>
          </div>
          <p class="text-xs text-emerald-200/80 leading-relaxed">
            Para salvaguardar la confianza de nuestros lectores y el cumplimiento estricto de las directrices E-E-A-T de Google, <strong>CompraMaestra no acepta pagos por publicar opiniones favorables</strong> ni modifica notas técnicas por solicitud comercial de fabricantes.
          </p>
        </div>
      </div>

      <!-- Formulario de contacto simulado -->
      <div class="lg:col-span-2 bg-white p-6 sm:p-10 rounded-3xl border border-emerald-100 shadow-sm">
        <!-- Banner de éxito (inicialmente oculto) -->
        <div id="form-success-banner" class="hidden mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-sm">
          <div class="flex items-center gap-2 font-bold mb-1">
            <span>✅</span>
            <span>¡Mensaje recibido correctamente!</span>
          </div>
          <p class="text-xs text-emerald-800">
            Gracias por contactar con CompraMaestra. Un editor técnico revisará tu consulta a la mayor brevedad posible.
          </p>
        </div>

        <!-- Banner de error (inicialmente oculto) -->
        <div id="form-error-banner" class="hidden mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-rose-900 text-sm">
          <div class="flex items-center gap-2 font-bold mb-1">
            <span>⚠️</span>
            <span>No se ha podido enviar el mensaje</span>
          </div>
          <p id="form-error-text" class="text-xs text-rose-800">
            Hubo un problema al procesar el envío. Por favor, revisa tus datos o inténtalo de nuevo en unos minutos.
          </p>
        </div>

        <form id="contact-form" class="space-y-5">
          <input type="hidden" name="access_key" value="d0f60e50-d742-4e30-94a6-82ecf9670632" />
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">
              Nombre o alias <span class="text-emerald-600">*</span>
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Ej. Carlos Mendoza" 
              class="w-full px-4 py-3 rounded-xl border border-emerald-200/90 text-sm text-emerald-950 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all bg-emerald-50/20"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">
              Correo electrónico <span class="text-emerald-600">*</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="tuemail@ejemplo.com" 
              class="w-full px-4 py-3 rounded-xl border border-emerald-200/90 text-sm text-emerald-950 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all bg-emerald-50/20"
            />
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">
              Motivo de la consulta <span class="text-emerald-600">*</span>
            </label>
            <select 
              id="subject" 
              name="subject" 
              required
              class="w-full px-4 py-3 rounded-xl border border-emerald-200/90 text-sm text-emerald-950 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all bg-white"
            >
              <option value="" disabled selected>Selecciona un motivo...</option>
              <option value="Duda técnica sobre un producto analizado">Duda técnica sobre un producto analizado</option>
              <option value="Sugerir un nuevo producto o comparativa">Sugerir un nuevo producto o comparativa</option>
              <option value="Notificar un error o enlace desactualizado">Notificar un error o enlace desactualizado</option>
              <option value="Consulta legal o derechos de privacidad">Consulta legal o derechos de privacidad</option>
              <option value="Otro asunto">Otro asunto</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-emerald-900 mb-1.5">
              Mensaje o detalle técnico <span class="text-emerald-600">*</span>
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required 
              placeholder="Explícanos tu duda con el mayor nivel de detalle posible..."
              class="w-full px-4 py-3 rounded-xl border border-emerald-200/90 text-sm text-emerald-950 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all bg-emerald-50/20 resize-y"
            ></textarea>
          </div>

          <div class="flex items-start gap-2.5 pt-1">
            <input 
              type="checkbox" 
              id="privacy" 
              name="privacy" 
              required
              class="mt-1 h-4 w-4 rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500"
            />
            <label for="privacy" class="text-xs text-emerald-900/80 leading-relaxed">
              He leído y acepto el <a href="/legal" class="text-emerald-700 font-semibold underline hover:text-emerald-900">Aviso Legal y la Política de Privacidad</a> para la gestión de esta consulta.
            </label>
          </div>

          <div class="pt-3">
            <button 
              id="submit-btn"
              type="submit" 
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-emerald-700 to-teal-800 text-white font-bold text-sm shadow-md shadow-emerald-900/20 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer disabled:pointer-events-none"
            >
              <span id="submit-btn-text">Enviar consulta al equipo</span>
              <span id="submit-btn-icon">📨</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const submitBtnText = document.getElementById('submit-btn-text');
    const submitBtnIcon = document.getElementById('submit-btn-icon');
    const successBanner = document.getElementById('form-success-banner');
    const errorBanner = document.getElementById('form-error-banner');
    const errorText = document.getElementById('form-error-text');

    if (form && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Deshabilitar botón temporalmente para evitar clics dobles
        submitBtn.disabled = true;
        const originalText = submitBtnText ? submitBtnText.textContent : 'Enviar consulta al equipo';
        const originalIcon = submitBtnIcon ? submitBtnIcon.textContent : '📨';
        
        if (submitBtnText) submitBtnText.textContent = 'Enviando consulta...';
        if (submitBtnIcon) submitBtnIcon.textContent = '⏳';
        submitBtn.classList.add('opacity-75', 'cursor-not-allowed');

        // Ocultar banners previos
        if (successBanner) successBanner.classList.add('hidden');
        if (errorBanner) errorBanner.classList.add('hidden');

        // 2. Extraer datos recogidos
        const formData = new FormData(form);
        const payload = {
          access_key: 'd0f60e50-d742-4e30-94a6-82ecf9670632',
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message')
        };

        try {
          // 3. Petición POST mediante fetch al endpoint de Web3Forms
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (response.ok && result.success) {
            // Éxito: mostrar banner, resetear formulario y mantener en la misma página
            if (successBanner) {
              successBanner.classList.remove('hidden');
              successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            form.reset();
          } else {
            throw new Error(result.message || 'No se pudo procesar la solicitud.');
          }
        } catch (err) {
          console.error('Error al enviar formulario a Web3Forms:', err);
          if (errorBanner) {
            if (errorText) {
              errorText.textContent = err.message || 'Hubo un problema al procesar el envío. Por favor, inténtalo de nuevo.';
            }
            errorBanner.classList.remove('hidden');
            errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            alert('No se pudo enviar el mensaje. Por favor, inténtalo de nuevo más tarde.');
          }
        } finally {
          // Restaurar estado del botón
          submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = originalText;
          if (submitBtnIcon) submitBtnIcon.textContent = originalIcon;
          submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        }
      });
    }
  </script>
</Layout>
